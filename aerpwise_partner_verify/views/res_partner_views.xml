<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_partner_verify" model="ir.ui.view">
        <field name="name">res.partner.form.partner.verify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_submit_verify"
                            type="object"
                            string="Submit for Verification"
                            class="btn-primary"
                            invisible="partner_verify_state not in ('draft', 'rejected')"
                            groups="aerpwise_partner_verify.group_partner_verify_user"/>
                    <button name="action_verify_partner"
                            type="object"
                            string="Verify"
                            class="btn-primary"
                            invisible="partner_verify_state != 'pending'"
                            groups="aerpwise_partner_verify.group_partner_verify_manager"/>
                    <button name="action_reject_verify"
                            type="object"
                            string="Reject"
                            invisible="partner_verify_state != 'pending'"
                            groups="aerpwise_partner_verify.group_partner_verify_manager"/>
                    <button name="action_reset_verify"
                            type="object"
                            string="Reset to Draft"
                            invisible="partner_verify_state == 'draft'"
                            groups="aerpwise_partner_verify.group_partner_verify_manager"/>
                    <field name="partner_verify_state" widget="statusbar"
                           statusbar_visible="draft,pending,verified"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Verification" name="partner_verify"
                      groups="aerpwise_partner_verify.group_partner_verify_user">
                    <group>
                        <group>
                            <field name="partner_verify_state"/>
                            <field name="partner_verify_user_id"/>
                            <field name="partner_verify_date"/>
                        </group>
                        <group>
                            <field name="partner_verify_note" placeholder="Internal notes / rejection reason"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_partner_verify" model="ir.ui.view">
        <field name="name">res.partner.list.partner.verify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="partner_verify_state" optional="show"
                       widget="badge"
                       decoration-success="partner_verify_state == 'verified'"
                       decoration-info="partner_verify_state == 'pending'"
                       decoration-danger="partner_verify_state == 'rejected'"
                       decoration-muted="partner_verify_state == 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_partner_verify" model="ir.ui.view">
        <field name="name">res.partner.search.partner.verify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Draft" name="partner_verify_draft"
                        domain="[('partner_verify_state', '=', 'draft')]"/>
                <filter string="To Verify" name="partner_verify_pending"
                        domain="[('partner_verify_state', '=', 'pending')]"/>
                <filter string="Verified" name="partner_verify_verified"
                        domain="[('partner_verify_state', '=', 'verified')]"/>
                <filter string="Rejected" name="partner_verify_rejected"
                        domain="[('partner_verify_state', '=', 'rejected')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_country']" position="after">
                <filter name="group_partner_verify_state" string="Verification Status"
                        context="{'group_by': 'partner_verify_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
