<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_partner_verify" model="ir.module.category">
        <field name="name">Partner Verify</field>
        <field name="description">Manage contact verification workflow</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_partner_verify_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_partner_verify"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_partner_verify_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_partner_verify"/>
        <field name="implied_ids" eval="[(4, ref('group_partner_verify_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
