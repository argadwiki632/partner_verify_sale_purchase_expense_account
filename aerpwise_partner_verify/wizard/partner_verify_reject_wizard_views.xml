<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_verify_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">partner.verify.reject.wizard.form</field>
        <field name="model">partner.verify.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Partner Verification">
                <group>
                    <field name="partner_ids" widget="many2many_tags" readonly="1"/>
                    <field name="note" placeholder="Explain why this contact is rejected..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
